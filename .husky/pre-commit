# Prevent .env files with secrets from being committed
STAGED_ENV_FILES=$(git diff --cached --name-only | grep -E '\.env$|\.env\.(?!example|security\.example)' || true)
if [ -n "$STAGED_ENV_FILES" ]; then
  echo "ERROR: Attempting to commit .env file with potential secrets!"
  echo "Files: $STAGED_ENV_FILES"
  echo "Use .env.example for templates instead."
  exit 1
fi

pnpm exec lint-staged
