# ============================================
# AiNeed (寻裳) 生产环境配置
# ============================================
# 填写说明：将所有空值替换为你的真实配置
# 密钥类：必须填写，否则服务无法启动
# 默认类：已给出合理默认值，通常不需修改

# ---------- 数据库 ----------
POSTGRES_PASSWORD=           # [必填] PostgreSQL 密码
POSTGRES_USER=xuno
POSTGRES_DB=xuno
DATABASE_URL=postgresql://xuno:${POSTGRES_PASSWORD}@postgres:5432/xuno?schema=public

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=               # [必填] Redis 密码
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ---------- MinIO 对象存储 ----------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=             # [必填] MinIO Access Key
MINIO_SECRET_KEY=             # [必填] MinIO Secret Key
MINIO_BUCKET=xuno
MINIO_USE_SSL=true
MINIO_PUBLIC_URL=             # [必填] 公网访问地址，如 https://cdn.xuno.com

# ---------- GLM / AI (核心功能) ----------
GLM_API_KEY=                  # [必填] 智谱AI API Key
GLM_API_ENDPOINT=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5
GLM_VISION_MODEL=glm-4v-plus
ZHIPU_API_KEY=                # [必填] 智谱AI API Key (同 GLM_API_KEY)

# ---------- 备选 LLM (可选，用于降级) ----------
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_API_ENDPOINT=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- AI 服务 ----------
AI_SERVICE_URL=http://ai-service:8002
ML_SERVICE_URL=http://ai-service:8002
BODY_ANALYSIS_SERVICE_URL=http://ai-service:8003
VIRTUAL_TRYON_URL=http://ai-service:8002
AI_STYLIST_API_KEY=           # 默认用 GLM_API_KEY
AI_STYLIST_DAILY_LIMIT=50
TRY_ON_DAILY_LIMIT=10
RECOMMENDATION_DAILY_LIMIT=100

# ---------- 向量数据库 ----------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_CLOTHING=xuno_clothing

# ---------- 知识图谱 ----------
NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=               # [必填] Neo4j 密码

# ---------- 支付 (上架前必配) ----------
ALIPAY_APP_ID=                # [必填] 支付宝应用ID
ALIPAY_PRIVATE_KEY=           # [必填] 支付宝应用私钥
ALIPAY_PUBLIC_KEY=            # [必填] 支付宝公钥
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=            # [必填] 支付回调地址，如 https://api.xuno.com/api/v1/payment/alipay/callback
ALIPAY_RETURN_URL=
ALIPAY_SANDBOX=false

WECHAT_MCH_ID=                # [必填] 微信支付商户号
WECHAT_APP_ID=                # [必填] 微信App ID
WECHAT_API_KEY=
WECHAT_API_V3_KEY=            # [必填] 微信V3 API密钥
WECHAT_SERIAL_NO=             # [必填] 证书序列号
WECHAT_PRIVATE_KEY=           # [必填] 商户私钥路径
WECHAT_CERT_PATH=
WECHAT_NOTIFY_URL=            # [必填] 微信回调地址

# ---------- 短信 ----------
SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=     # [必填] 阿里云短信AK
ALIYUN_SMS_ACCESS_KEY_SECRET= # [必填] 阿里云短信SK
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION=cn-hangzhou

# ---------- 微信 OAuth ----------
WECHAT_OAUTH_APP_ID=
WECHAT_OAUTH_APP_SECRET=
WECHAT_OAUTH_REDIRECT_URI=

# ---------- JWT ----------
JWT_SECRET=                   # [必填] JWT签名密钥，至少64位hex字符串 (512-bit)
JWT_REFRESH_SECRET=           # [必填] JWT刷新密钥，至少64位hex字符串
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- CSRF ----------
CSRF_SECRET=                  # [必填] CSRF密钥，至少32位

# ---------- 数据加密 ----------
ENCRYPTION_KEY=               # [必填] AES-256-GCM 加密密钥，64位hex
PII_ENCRYPTION_ENABLED=true

# ---------- 前端 API 地址 ----------
MOBILE_API_URL=               # [必填] 后端公网地址，如 https://api.xuno.com

# ---------- CORS ----------
CORS_ORIGINS=                 # [必填] 允许的前端域名，逗号分隔

# ---------- 应用 ----------
NODE_ENV=production
PORT=3001
ADMIN_PORT=3002
SERVICE_NAME=xuno-backend
FRONTEND_URL=                 # [必填] 前端地址，如 https://xuno.com
BACKEND_URL=                  # [必填] 后端地址，如 https://api.xuno.com

# ---------- 日志 ----------
LOG_LEVEL=info

# ---------- 监控 ----------
SENTRY_DSN=

# ---------- 备份 ----------
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_DEST=minio

# ---------- 容量规划 ----------
CAPACITY_MAX_CONCURRENT_USERS=50
CAPACITY_CPU_SCALE_UP_THRESHOLD=0.7
CAPACITY_CPU_SCALE_DOWN_THRESHOLD=0.3
CAPACITY_AUTO_SCALE_ENABLED=false
